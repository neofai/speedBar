<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SpeedBar</AssemblyName>
    <RootNamespace>SpeedBar</RootNamespace>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Authors>Neo</Authors>
    <Description>A lightweight Windows 11 taskbar network and system monitor.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <DebugType>embedded</DebugType>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts\**;dist*\**;SpeedBar-current\**;SpeedBar-optimized\**;tests\**</DefaultItemExcludes>
    <ApplicationIcon>Assets\speedbar.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NuGetAudit>false</NuGetAudit>
    <!-- WPF owns startup; the WinForms ApplicationConfiguration initializer is not used.
         The manifest must declare DPI awareness before either UI stack creates an HWND. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\speedbar.ico" />
  </ItemGroup>
</Project>

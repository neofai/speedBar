<Window x:Class="SpeedBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpeedBar 设置" Width="390" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/><RowDefinition Height="42"/>
            <RowDefinition Height="42"/><RowDefinition Height="42"/>
            <RowDefinition Height="42"/><RowDefinition Height="42"/>
            <RowDefinition Height="42"/><RowDefinition Height="42"/>
            <RowDefinition Height="64"/><RowDefinition Height="42"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="上传颜色" VerticalAlignment="Center"/>
        <Button Grid.Row="0" Grid.Column="1" x:Name="UploadColorButton" Click="ChooseColor"/>
        <TextBlock Grid.Row="1" Text="下载颜色" VerticalAlignment="Center"/>
        <Button Grid.Row="1" Grid.Column="1" x:Name="DownloadColorButton" Click="ChooseColor"/>
        <TextBlock Grid.Row="2" Text="CPU 颜色" VerticalAlignment="Center"/>
        <Button Grid.Row="2" Grid.Column="1" x:Name="CpuColorButton" Click="ChooseColor"/>
        <TextBlock Grid.Row="3" Text="内存颜色" VerticalAlignment="Center"/>
        <Button Grid.Row="3" Grid.Column="1" x:Name="MemoryColorButton" Click="ChooseColor"/>
        <TextBlock Grid.Row="4" Text="背景颜色" VerticalAlignment="Center"/>
        <Button Grid.Row="4" Grid.Column="1" x:Name="BackgroundColorButton" Click="ChooseColor"/>
        <CheckBox Grid.Row="5" Grid.ColumnSpan="2" x:Name="TransparentBackgroundCheck"
                  Content="使用透明背景" VerticalAlignment="Center"
                  Checked="TransparentBackgroundChanged" Unchecked="TransparentBackgroundChanged"/>
        <TextBlock Grid.Row="6" Text="字体大小" VerticalAlignment="Center"/>
        <Slider Grid.Row="6" Grid.Column="1" x:Name="FontSizeSlider" Minimum="10" Maximum="20"
                TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
        <TextBlock Grid.Row="7" Text="刷新间隔" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="7" Grid.Column="1" x:Name="RefreshCombo" VerticalAlignment="Center">
            <ComboBoxItem Tag="500">500 毫秒</ComboBoxItem>
            <ComboBoxItem Tag="1000">1 秒</ComboBoxItem>
            <ComboBoxItem Tag="2000">2 秒</ComboBoxItem>
        </ComboBox>
        <TextBlock Grid.Row="8" Text="停靠位置" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="8" Grid.Column="1" VerticalAlignment="Center">
            <ComboBox x:Name="DockSideCombo">
                <ComboBoxItem Tag="Left">靠左</ComboBoxItem>
                <ComboBoxItem Tag="Right">靠右</ComboBoxItem>
            </ComboBox>
            <TextBlock x:Name="DockSideHint" Margin="0,4,0,0" FontSize="11" Foreground="Gray"/>
        </StackPanel>
        <CheckBox Grid.Row="9" Grid.ColumnSpan="2" x:Name="StartupCheck"
                  Content="登录 Windows 后自动启动" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Content="取消" Width="80" Height="32" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="保存" Width="80" Height="32" IsDefault="True" Click="SaveClick"/>
        </StackPanel>
    </Grid>
</Window>

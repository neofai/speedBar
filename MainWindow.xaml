<Window x:Class="SpeedBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpeedBar" Width="166" Height="42"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        ShowInTaskbar="False" ShowActivated="False" Topmost="False" Background="Transparent"
        SizeToContent="WidthAndHeight" Cursor="Arrow">
    <Border x:Name="RootBorder" CornerRadius="5" Padding="10,5"
            MinWidth="176" MinHeight="46" SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="UploadText" Grid.Row="0" Grid.Column="0" Text="↑ 0 B/s"/>
            <TextBlock x:Name="DownloadText" Grid.Row="1" Grid.Column="0" Text="↓ 0 B/s"/>
            <TextBlock x:Name="CpuText" Grid.Row="0" Grid.Column="2" Text="CPU 0%"/>
            <TextBlock x:Name="MemoryText" Grid.Row="1" Grid.Column="2" Text="RAM 0%"/>
        </Grid>
    </Border>
</Window>

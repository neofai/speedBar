<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <StartupObject>SpeedBar.WindowsSmoke.Program</StartupObject>
    <ApplicationManifest>smoke.manifest</ApplicationManifest>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../SpeedBar.csproj" />
    <Resource Include="../../Assets/speedbar.ico" Link="Assets/speedbar.ico" />
  </ItemGroup>
</Project>
